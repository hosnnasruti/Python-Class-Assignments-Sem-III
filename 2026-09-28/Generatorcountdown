def countdown(n):
    while n>=1 :
        yield n
        n -= 1
try:
    start_num = int(input("Enter a starting integer for countdown: "))
    print("Countdown: ")
    for number in countdown(start_num):
        print(number)
except ValueError:
    print("Invalid input. Please enter a valid integer.")

